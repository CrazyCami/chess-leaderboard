# Copy this file to .env.local and fill in the project URL and publishable key.
# A publishable key is safe in browser code when Row Level Security is enabled.
# Never put a secret/service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_key
